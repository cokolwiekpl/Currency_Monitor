# Required for the default primary profile. Paste your own Discord webhook URL.
DISCORD_WEBHOOK_PRIMARY=

# Required only when enabling the secondary profile in example_multi_source.json.
DISCORD_WEBHOOK_SECONDARY=

CHECK_INTERVAL_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=20

# Optional Uptime Kuma Push monitor. Leave empty or omit to disable.
# Paste the full Push URL copied from your monitor, including its token.
UPTIME_KUMA_PUSH_URL=

# Optional authenticated JSON provider. Reference this variable in headers_env.
# Include the authentication scheme if required by the provider, e.g. Bearer.
# BANK_API_TOKEN=

# Local Python defaults. Compose sets its own container paths.
# CONFIG_PATH=config/alerts.json
# STATE_PATH=data/state.json

# Production image tag. Omit for the latest default-branch build.
# IMAGE_TAG=latest

# Optional complete monitoring configuration. Omit this variable to use the file.
# An explicitly empty or invalid value is an error. Paste raw JSON in Portainer.
# For a local .env file, enclose the JSON in single quotes.
# ALERTS_CONFIG_JSON='{"sources":{"nbp":{"type":"nbp"}},"profiles":[{"id":"primary","source":"nbp","webhook_env":"DISCORD_WEBHOOK_PRIMARY","alerts":[{"id":"usd-above-4","currency":"USD","rate_type":"mid","direction":"above","threshold":"4.00"},{"id":"eur-below-4-20","currency":"EUR","rate_type":"mid","direction":"below","threshold":"4.20"}]}]}'
